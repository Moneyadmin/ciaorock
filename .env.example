# --- Supabase (Project Settings → API) ---
# Le variabili VITE_* sono pubbliche: finiscono nel codice del browser.
VITE_SUPABASE_URL=https://<progetto>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable / anon key>
VITE_SUPABASE_PROJECT_ID=<progetto>
SUPABASE_URL=https://<progetto>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable / anon key>
# Segreta: solo sul server, mai nel browser né su git.
SUPABASE_SERVICE_ROLE_KEY=<service_role / secret key>

# --- AI (OpenRouter: https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=<chiave openrouter>
# Facoltativi: modelli usati (ID OpenRouter)
# AI_VISION_MODEL=google/gemini-3.6-flash
# AI_TEXT_MODEL=openai/gpt-6-astra

# Facoltativo: segreto per firmare l'approvazione AI delle foto (se assente usa la service role key)
# PHOTO_TOKEN_SECRET=<stringa casuale lunga>

# Solo durante l'importazione dei dati dalla vecchia app (pagina /setup): poi va rimosso
# SETUP_SECRET=<stringa casuale lunga>

# --- Deploy ---
# Dominio pubblico (serve a Caddy per l'HTTPS e come referer per OpenRouter)
DOMAIN=ciaorock.com
PUBLIC_SITE_URL=https://ciaorock.com

# Solo per drizzle-kit (migrazioni): stringa di connessione Postgres di Supabase
# DATABASE_URL=postgresql://postgres:<password>@db.<progetto>.supabase.co:5432/postgres
